# ==============================================================
# NILE ECOSYSTEM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================

# 1. DATABASE CONFIGURATION (100% FREE CLOUD TIER)
# --------------------------------------------------------------
# OPTION A: Neon Serverless PostgreSQL (Recommended - 100% Free at https://neon.tech)
# DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require"
#
# OPTION B: Supabase PostgreSQL (100% Free at https://supabase.com)
# DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
#
# OPTION C: Local SQLite (Zero setup for quick local testing)
DATABASE_URL="file:./dev.db"

# 2. JWT SECURITY & SESSION AUTH
# --------------------------------------------------------------
JWT_SECRET="nile_super_secure_production_jwt_secret_key_2026_xyz"
JWT_EXPIRES_IN="7d"

# 3. SERVER & PORT
# --------------------------------------------------------------
PORT=5000
NODE_ENV="production"
CORS_ORIGIN="*"

# 4. DEFAULT SUPER ADMIN CREDENTIALS
# --------------------------------------------------------------
ADMIN_EMAIL="admin@nileecosystem.com"
ADMIN_DEFAULT_PASSWORD="AdminNileSecure2026!"

# 5. FRONTEND API ROUTING
# --------------------------------------------------------------
VITE_API_URL="/api"
